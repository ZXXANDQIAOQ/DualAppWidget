<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Android 11 (API 30) 起，默认只能“看到”自己的应用。
        为了让配置界面能列出所有已安装应用、并且 getLaunchIntentForPackage 能拿到启动 Intent，
        这里申请 QUERY_ALL_PACKAGES；同时用 <queries> 声明 MAIN/LAUNCHER 意图查询。
        个人自用，不上架商店，因此不需要考虑 Google Play 的权限审核限制。
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
            桌面小部件的 <receiver> 不在这里声明 —— 它按「身份」分成两份，放在各自的 flavor 清单里：

            - app/src/add/AndroidManifest.xml    普通 AppWidget 身份（面板可见，用来新建实例）
            - app/src/stack/AndroidManifest.xml  米系小部件身份（miuiWidget=true，可堆叠，面板不可见）

            原因见 README「澎湃 OS 4 堆叠」一节：这两件事在澎湃 OS 上是互斥的，
            所以要同一个包名出两个 APK，互相覆盖安装来切换。
        -->

        <!--
            实例管理页：应用启动入口。
            桌面上可以有多个小部件实例，这里统一列出并逐个配置。
        -->
        <activity
            android:name=".WidgetListActivity"
            android:exported="true"
            android:label="@string/manager_title"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            配置界面：
            1) 添加小部件时由桌面通过 APPWIDGET_CONFIGURE 拉起（必须 exported=true，因为是别的应用启动它）
            2) 长按小部件选「编辑」（widgetFeatures=reconfigurable）时也走这里
            3) 管理页点「编辑」也走这里
            不能用 singleTop：连续配置不同实例时会被复用导致 widgetId 串掉
        -->
        <activity
            android:name=".ConfigActivity"
            android:exported="true"
            android:label="@string/config_title"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>

</manifest>
